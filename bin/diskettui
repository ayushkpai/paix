#!/usr/bin/env ruby

require "io/console"

class Diskettui
  RESET = "\e[0m"
  BOLD  = "\e[1m"
  DIM   = "\e[2m"
  CYAN  = "\e[36m"
  BLUE  = "\e[34m"
  WHITE = "\e[97m"

  ESC     = "\e"
  CTRL_C  = "\x03"

  def initialize
    @root = File.expand_path("~")
    @cwd = @root

    @stack = []
    @index = 0

    load_files

    STDOUT.sync = true
  end

  def load_files
    @files = Dir.entries(@cwd)
      .reject { |file| file == "." || file == ".." }
      .sort_by(&:downcase)

    @index = 0 if @index >= @files.length
  end

  def clear
    print "\e[2J\e[H"
  end

  def hide_cursor
    print "\e[?25l"
  end

  def show_cursor
    print "\e[?25h"
  end

  def line(text = "")
    print text
    print "\r\n"
  end

  def draw
    clear

    line
    line "  #{BOLD}#{CYAN}Diskettui#{RESET}"
    line "  #{DIM}#{@cwd}#{RESET}"
    line

    if @files.empty?
      line "  #{DIM}No files here#{RESET}"
    else
      @files.each_with_index do |file, index|
        draw_file(file, index)
      end
    end

    line
    line "  #{DIM}#{'─' * 56}#{RESET}"
    line
    line "  #{DIM}↑↓#{RESET} move  " \
         "#{DIM}Enter#{RESET} open  " \
         "#{DIM}Esc#{RESET} back  " \
         "#{DIM}Ctrl+C#{RESET} quit"
  end

  def draw_file(file, index)
    path = File.join(@cwd, file)
    selected = index == @index

    if File.directory?(path)
      icon = "▸"
      color = BLUE
    else
      icon = "•"
      color = WHITE
    end

    if selected
      line "  #{CYAN}❯#{RESET} #{BOLD}#{color}#{icon} #{file}#{RESET}"
    else
      line "    #{color}#{icon} #{file}#{RESET}"
    end
  end

  def up
    return if @files.empty?

    @index -= 1
    @index = @files.length - 1 if @index < 0
  end

  def down
    return if @files.empty?

    @index += 1
    @index = 0 if @index >= @files.length
  end

  def back
    return if @stack.empty?

    @cwd = @stack.pop
    @index = 0

    load_files
  end

  def enter
    return if @files.empty?

    path = File.join(@cwd, @files[@index])

    if File.directory?(path)
      @stack << @cwd
      @cwd = path
      @index = 0

      load_files
    else
      view_file(path)
    end
  end

  def view_file(path)
    content =
      begin
        File.readlines(path, chomp: true)
      rescue
        ["[cannot read file]"]
      end

    loop do
      clear

      line
      line "  #{BOLD}#{CYAN}FILE VIEW#{RESET}"
      line "  #{DIM}#{path}#{RESET}"
      line
      line "  #{DIM}#{'─' * 56}#{RESET}"

      content.each do |text|
        line "  #{text}"
      end

      line "  #{DIM}#{'─' * 56}#{RESET}"
      line
      line "  #{DIM}Esc#{RESET} back  #{DIM}Ctrl+C#{RESET} quit"

      key = read_key

      case key
      when :escape
        return
      when :ctrl_c
        quit
      end
    end
  end

  def read_key
    first = STDIN.getch

    return :ctrl_c if first == CTRL_C

    if first == ESC
      ready = IO.select([STDIN], nil, nil, 0.05)
      return :escape unless ready

      second = STDIN.getch

      if second == "["
        ready = IO.select([STDIN], nil, nil, 0.05)

        return :escape unless ready

        third = STDIN.getch

        case third
        when "A"
          return :up

        when "B"
          return :down

        else
          return :escape
        end
      end

      return :escape
    end

    return :enter if first == "\r" || first == "\n"

    first
  end

  def quit
    show_cursor
    clear
    exit
  end

  def run
    hide_cursor

    begin
      STDIN.raw do
        loop do
          draw

          case read_key
          when :up
            up

          when :down
            down

          when :enter
            enter

          when :escape
            back

          when :ctrl_c
            quit
          end
        end
      end
    ensure
      show_cursor
      clear
    end
  end
end

Diskettui.new.run
